{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://modrinth.com/mod/useful-fun-server-tweaks",
    "issues": "https://github.com/JustMili0/MilliesServerAdditions/issues",
    "sources": "https://github.com/JustMili0/MilliesServerAdditions"
  },
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "main": [
      "net.justmili.servertweaks.ServerTweaks"
    ],
    "client": [
      "net.justmili.servertweaks.client.FabricClient"
    ],
    "fabric-datagen": [
      "net.justmili.servertweaks.core.datagen.DataGenerator"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_constraint}"
  }
}